# Each repository is cloned as an independent git repository.
# Keep this workspace repo free of their contents.
/wirewatch/
/simple-netmon/
/openprocmon/
/systeminformer/

# Local toolchains, caches and build output
/.tools/
/.venv/
/dist/
*.log

# Resilience runtime state (session ids, local paths, cursors).
# node-scores.json is measured reference data and IS tracked.
/logs/resilience/events-*.jsonl
/logs/resilience/actions-*.jsonl
/logs/resilience/*-state.json

# Local skill config copies
*.bak

# Python bytecode
__pycache__/
*.py[cod]

# Docs tooling baseline: scratch copies and per-run snapshots are local.
# baseline.json IS tracked: it is the reference the drift check compares to.
/oc-error-monitor/v1.1.0-beta.1/testenv/docs_baseline/scratch/
/oc-error-monitor/v1.1.0-beta.1/testenv/docs_baseline/before.json
/oc-error-monitor/v1.1.0-beta.1/testenv/docs_baseline/after.json

# Test harness scratch: the proxy copy and its logs are per-run artifacts.
**/testenv/_run/
.playwright-mcp/

# runtime state written beside the script (oc-error-monitor)
settings.json
settings.json.tmp
route_state.json
gateway.json
gateway.json.tmp
# captured request headers/bodies: local session ids and prompts
headers-dump.jsonl
